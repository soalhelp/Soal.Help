#!/usr/bin/env bash
# soal — Codex CLI launcher for Soal.help

set -euo pipefail

ENV_FILE="$HOME/.codex/.env"
CONFIG_FILE="$HOME/.codex/config.toml"

BOLD=$'\033[1m'; RESET=$'\033[0m'
CYAN=$'\033[96m'; GREEN=$'\033[92m'
YELLOW=$'\033[93m'; RED=$'\033[91m'

if [ ! -f "$CONFIG_FILE" ]; then
  echo -e "${RED}✗ الإعدادات مش موجودة: ${CONFIG_FILE}${RESET}"
  echo "شغّل install.sh الأول."
  exit 1
fi

# Meta commands don't need an API key or codex binary
case "${1:-}" in
  --help|-h|help|--list|list|reasoning|default|set-default) ;;
  *)
    if [ -f "$ENV_FILE" ]; then
      __key=$(grep -Eo 'sk-[A-Za-z0-9_-]{20,}' "$ENV_FILE" 2>/dev/null | head -1)
      [ -n "$__key" ] && export SOAL_API_KEY="$__key"
      unset __key
    fi

    if [ -z "${SOAL_API_KEY:-}" ]; then
      echo -e "${RED}✗ مفتاح API مش متظبّط.${RESET}"
      echo -e "شغّل: ${YELLOW}curl -fsSL https://raw.githubusercontent.com/soalhelp/Soal.Help/main/termux/install.sh | bash${RESET}"
      exit 1
    fi

    if ! command -v codex >/dev/null 2>&1; then
      echo -e "${RED}✗ Codex CLI مش مثبّت.${RESET}"
      echo "ثبّته: ${YELLOW}npm install -g @mmmbuto/codex-cli-termux@latest${RESET}"
      exit 1
    fi
    ;;
esac

declare -a MODELS=(
  "claude-haiku|claude-haiku-4-5-20251001|Claude Haiku 4.5 (سريع ورخيص)"
  "claude-sonnet|claude-sonnet-4-5-20250929|Claude Sonnet 4.5 (متوازن)"
  "claude-sonnet-46|claude-sonnet-4-6|Claude Sonnet 4.6 (أحدث — سياق 1M)"
  "claude-opus|claude-opus-4-8|Claude Opus 4.8 (أقوى — سياق 1M)"
  "claude-opus-47|claude-opus-4-7|Claude Opus 4.7 (سياق 1M)"
  "claude-fable|claude-fable-5|Claude Fable 5 (سياق 1M)"
  "gpt-mini|gpt-5-mini|GPT-5 Mini (سريع)"
  "gpt5|gpt-5.5|GPT-5.5 (متقدّم — سياق 1M)"
  "gpt54|gpt-5.4|GPT-5.4 (سياق 1M)"
  "gpt-4o|gpt-4o|GPT-4o"
  "gpt41-mini|gpt-4.1-mini|GPT-4.1 Mini (سياق 1M رخيص)"
  "o3|o3|O3 (تفكير عميق)"
  "o4-mini|o4-mini|O4 Mini (تفكير سريع)"
  "gemini-pro|gemini-3.1-pro-preview|Gemini 3.1 Pro (Preview — سياق 1M)"
  "gemini-25-pro|gemini-2.5-pro|Gemini 2.5 Pro (سياق 1M)"
  "gemini-flash|gemini-3.5-flash|Gemini 3.5 Flash (سريع — سياق 1M)"
  "gemini-flash-3|gemini-3-flash-preview|Gemini 3 Flash (Preview — سياق 1M)"
  "gemini-25-flash|gemini-2.5-flash|Gemini 2.5 Flash (أرخص)"
)

lookup_model() {
  local a="$1"
  for m in "${MODELS[@]}"; do
    IFS='|' read -r alias id _label <<< "$m"
    if [ "$alias" = "$a" ] || [ "$id" = "$a" ]; then
      echo "$id"
      return
    fi
  done
  echo "$a"
}

lookup_profile() {
  local a="$1"
  for m in "${MODELS[@]}"; do
    IFS='|' read -r alias id _label <<< "$m"
    if [ "$alias" = "$a" ] || [ "$id" = "$a" ]; then
      echo "$alias"
      return
    fi
  done
  echo ""
}

run_codex() {
  local sel="$1"; shift
  local profile model_id
  profile=$(lookup_profile "$sel")
  model_id=$(lookup_model "$sel")
  echo -e "${GREEN}→ Model:${RESET} $model_id"
  if [ -n "$profile" ]; then
    exec codex --profile "$profile" "$@"
  else
    exec codex --model "$model_id" "$@"
  fi
}

print_list() {
  echo -e "${CYAN}${BOLD}الموديلات المتاحة:${RESET}"
  for m in "${MODELS[@]}"; do
    IFS='|' read -r alias id label <<< "$m"
    printf "  ${GREEN}%-16s${RESET} → ${label} ${YELLOW}(%s)${RESET}\n" "$alias" "$id"
  done
}

set_reasoning() {
  local level="$1"
  case "$level" in
    minimal|low|medium|high) ;;
    *)
      echo -e "${RED}✗ قيمة غير صحيحة: $level${RESET}"
      echo "المتاح: minimal | low | medium | high"
      exit 1
      ;;
  esac
  if [ ! -f "$CONFIG_FILE" ]; then
    echo -e "${RED}✗ $CONFIG_FILE مش موجود${RESET}"
    exit 1
  fi
  if grep -q '^model_reasoning_effort' "$CONFIG_FILE"; then
    sed -i.tmp "s|^model_reasoning_effort.*|model_reasoning_effort = \"$level\"|" "$CONFIG_FILE" 2>/dev/null || \
      sed -i '' "s|^model_reasoning_effort.*|model_reasoning_effort = \"$level\"|" "$CONFIG_FILE"
    rm -f "$CONFIG_FILE.tmp"
  else
    printf '\nmodel_reasoning_effort = "%s"\n' "$level" >> "$CONFIG_FILE"
  fi
  echo -e "${GREEN}✓ reasoning_effort = ${BOLD}$level${RESET}"
}

set_default_model() {
  local alias="$1"
  local model_id
  model_id=$(lookup_model "$alias")
  if [ "$model_id" = "$alias" ] && ! grep -qE "\\|${alias}\\|" <<< "$(printf '%s\n' "${MODELS[@]}")"; then
    echo -e "${RED}✗ Alias مش موجود: $alias${RESET}"
    echo "شوف القائمة: soal --list"
    exit 1
  fi
  if grep -qE '^model\s*=' "$CONFIG_FILE"; then
    sed -i.tmp "s|^model\s*=.*|model = \"$model_id\"|" "$CONFIG_FILE" 2>/dev/null || \
      sed -i '' "s|^model\s*=.*|model = \"$model_id\"|" "$CONFIG_FILE"
    rm -f "$CONFIG_FILE.tmp"
  else
    printf '\nmodel = "%s"\n' "$model_id" >> "$CONFIG_FILE"
  fi
  echo -e "${GREEN}✓ الموديل الافتراضي: ${BOLD}$model_id${RESET}"
}

print_help() {
  cat <<EOF
${CYAN}${BOLD}soal — Codex CLI launcher for Soal.help${RESET}

الاستخدام:
  ${GREEN}soal${RESET}                        قائمة تفاعلية لاختيار موديل
  ${GREEN}soal <alias>${RESET}                يشغّل الموديل ده مباشرة
  ${GREEN}soal <alias> "prompt"${RESET}       يشغّله بسؤال
  ${GREEN}soal --list${RESET}                 يعرض كل الـ 18 موديل
  ${GREEN}soal reasoning <level>${RESET}      يضبط عمق التفكير (minimal|low|medium|high)
  ${GREEN}soal default <alias>${RESET}        يخلي الموديل ده هو الافتراضي
  ${GREEN}soal --help${RESET}                 يعرض المساعدة دي

أمثلة:
  ${YELLOW}soal claude-opus${RESET}
  ${YELLOW}soal gpt5 "اكتب لي مقال عن مصر"${RESET}
  ${YELLOW}soal reasoning high${RESET}          # للـ O3/O4-Mini/GPT-5 (reasoning models)
  ${YELLOW}soal default claude-sonnet-46${RESET}  # يبقى هو اللي يفتح لما تكتب codex

الرصيد: ${CYAN}https://soal.help/app/dashboard${RESET}
EOF
}

if [ $# -ge 1 ]; then
  case "$1" in
    --list|list)
      print_list; exit 0 ;;
    --help|-h|help)
      print_help; exit 0 ;;
    reasoning)
      shift
      [ $# -eq 0 ] && { echo "الاستخدام: soal reasoning <minimal|low|medium|high>"; exit 1; }
      set_reasoning "$1"; exit 0 ;;
    default|set-default)
      shift
      [ $# -eq 0 ] && { echo "الاستخدام: soal default <alias>"; exit 1; }
      set_default_model "$1"; exit 0 ;;
  esac
fi

if [ $# -ge 1 ] && [[ "$1" != -* ]]; then
  SEL="$1"; shift
  run_codex "$SEL" "$@"
fi

echo -e "${CYAN}${BOLD}اختر موديل Soal.help:${RESET}"

LABELS=()
ALIASES=()
for m in "${MODELS[@]}"; do
  IFS='|' read -r alias id label <<< "$m"
  LABELS+=("$(printf '%-16s → %s' "$alias" "$label")")
  ALIASES+=("$alias")
done

if command -v fzf >/dev/null 2>&1; then
  sel=$(printf '%s\n' "${LABELS[@]}" | fzf --prompt='> ' --height=40% --reverse) || {
    echo "اتلغى."; exit 130;
  }
  idx=-1
  for i in "${!LABELS[@]}"; do
    if [ "${LABELS[$i]}" = "$sel" ]; then
      idx=$i; break
    fi
  done
  SEL="${ALIASES[$idx]}"
else
  for i in "${!LABELS[@]}"; do
    printf "  %2d) %s\n" $((i+1)) "${LABELS[$i]}"
  done
  read -rp "الاختيار [1-${#ALIASES[@]}]: " n
  if ! [[ "$n" =~ ^[0-9]+$ ]] || [ "$n" -lt 1 ] || [ "$n" -gt "${#ALIASES[@]}" ]; then
    echo -e "${RED}اختيار مش صحيح${RESET}"; exit 1
  fi
  SEL="${ALIASES[$((n-1))]}"
fi

run_codex "$SEL"
